# Copy to .env before starting the database:
#   cp .env.example .env
#
# These are for the local Docker Compose database only. The RDS password is
# generated by Terraform and stored in Secrets Manager.

POSTGRES_DB=hotels
POSTGRES_USER=hotels_admin
POSTGRES_PASSWORD=localdev_only_not_a_real_secret

# Host port mapped to 5432 in the container. Change it if you already have
# PostgreSQL running locally.
POSTGRES_PORT=5432

# Where backup.sh writes dumps.
BACKUP_DIR=backups

# How many dumps to keep before the oldest are removed.
BACKUP_RETENTION=10
